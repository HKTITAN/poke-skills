{
  // Skills are prose-heavy — relax line-length and allow inline HTML / duplicate headings across files.
  "default": true,
  "MD013": false,                // line length
  "MD024": { "siblings_only": true },  // duplicate headings (allow same heading in different sections)
  "MD033": false,                // inline HTML
  "MD041": false,                // first line must be h1 (frontmatter trips this)
  "MD036": false,                // emphasis used instead of heading (we use bold inline a lot)
  "MD012": { "maximum": 2 }      // multiple blank lines
}
